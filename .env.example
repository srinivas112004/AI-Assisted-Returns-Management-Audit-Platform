# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="Yotaa AI Returns Management & Audit Platform"
API_V1_STR=/api

# Database Configuration
# Default zero-configuration SQLite:
DATABASE_URL=sqlite:///./backend/app.db

# Production / MySQL alternative:
# DATABASE_URL=mysql+pymysql://yotaa_user:yotaa_secret@localhost:3306/returns_management_db

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Synthetic Data Generation Seed
RANDOM_SEED=20261022

# Admin / Auth Security (Simulated Header Token)
ADMIN_API_KEY=yotaa-secure-admin-token-2026

